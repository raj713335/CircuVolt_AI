# CircularDrive AI - Environment Configuration
# Copy this to .env and fill in your values

# OpenAI API Key (required for LLM-powered agent)
OPENAI_API_KEY=your-openai-api-key-here

# Model selection (optional, defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
FRONTEND_URL=http://localhost:5173

# MCP Server
MCP_SERVER_PORT=8001

# A2A Agent
A2A_AGENT_PORT=8002



# ──────────────────────────────────────────────────────────────
# CircuVolt AI – Environment Configuration Template
# Copy to .env and fill in your credentials
# ──────────────────────────────────────────────────────────────

# --- LLM Provider Switch ---
# "openai" = Direct OpenAI / Azure / vLLM endpoint
LLM_PROVIDER=openai



# --- OpenAI / Compatible (when LLM_PROVIDER=openai) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_BASE=              # optional: Azure/vLLM/Ollama base URL
